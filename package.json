{
  "name": "helix-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A WebGL portfolio: projects on a scroll-driven Three.js helix, built with Nuxt 4 and generated as a static site.",
  "scripts": {
    "dev": "npm run assets && nuxt dev",
    "build": "npm run assets && nuxt build",
    "generate": "npm run assets && nuxt generate",
    "preview": "npx serve .output/public",
    "assets": "node scripts/make-placeholders.mjs --if-missing && node scripts/build-og.mjs",
    "og": "node scripts/build-og.mjs",
    "placeholders": "node scripts/make-placeholders.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "lenis": "^1.3.27",
    "nuxt": "^4.1.0",
    "three": "~0.170.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/three": "~0.170.0",
    "sharp": "^0.34.0"
  },
  "engines": {
    "node": ">=20"
  }
}
